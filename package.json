{
  "name": "@madebyjulz/schwifty-ts",
  "version": "2026.10.0",
  "description": "IBAN and BIC validation, generation and bank lookup. A 1:1 TypeScript port of the Python schwifty package.",
  "keywords": [
    "bank",
    "bban",
    "bic",
    "iban",
    "iso13616",
    "iso9362",
    "schwifty",
    "sepa",
    "swift",
    "validation"
  ],
  "homepage": "https://github.com/madebyjulz/schwifty-ts#readme",
  "bugs": {
    "url": "https://github.com/madebyjulz/schwifty-ts/issues"
  },
  "license": "MIT",
  "author": "Julius von Egloffstein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madebyjulz/schwifty-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.mjs",
    "./src/checksum/*.ts"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node scripts/consolidate-registry.ts",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "sync:upstream": "node scripts/sync-upstream.ts",
    "git-publish": "git-publish",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "git-publish": "^2.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "ultracite": "8.0.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.6",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.14.0",
  "schwifty": {
    "upstream": "810930b432d9bc032e629b23cf1f8f1d25cf305f",
    "upstreamTag": "2026.10.0"
  }
}
