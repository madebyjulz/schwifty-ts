{
  "name": "@madebyjulz/schwifty-ts",
  "version": "2026.11.3",
  "description": "IBAN and BIC validation, generation and bank lookup. A 1:1 TypeScript port of the Python schwifty package.",
  "keywords": [
    "bank",
    "bban",
    "bic",
    "iban",
    "iso13616",
    "iso9362",
    "schwifty",
    "sepa",
    "swift",
    "validation"
  ],
  "homepage": "https://github.com/madebyjulz/schwifty-ts#readme",
  "bugs": {
    "url": "https://github.com/madebyjulz/schwifty-ts/issues"
  },
  "license": "MIT",
  "author": "Julius von Egloffstein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madebyjulz/schwifty-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.mjs",
    "./src/checksum/*.ts"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node scripts/consolidate-registry.ts",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsrs -p tsconfig.json",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "sync:upstream": "node scripts/sync-upstream.ts",
    "parity": "pnpm run build && node scripts/parity-upstream.ts",
    "git-publish": "git-publish",
    "prepublishOnly": "pnpm run parity",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "git-publish": "^2.5.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsdown": "^0.23.7",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "ultracite": "8.2.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.6",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.21.0",
  "schwifty": {
    "upstream": "379011f1c984765d67ba61b2933c0b4fa5437619",
    "upstreamTag": "2026.11.3"
  }
}
